# Copy to .env (never commit .env). Placeholders only — replace every value.

# Profile: dev (file H2, default) or prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# HS256 signing key for access tokens: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
CRX_JWT_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (prod profile)
CRX_DB_URL=jdbc:postgresql://db:5432/codereviewx
CRX_DB_USER=codereviewx
CRX_DB_PASSWORD=replace-me

# Where the static frontend lives, relative to the working directory (default: ..)
CRX_FRONTEND_DIR=..

# Base URL used in password-reset links
CRX_RESET_LINK_BASE=https://your-domain.example/index.html

# Only when the frontend is served from a different origin (comma-separated, exact origins)
CRX_ALLOWED_ORIGINS=

# Behind a TLS-terminating proxy: native or framework (so Secure cookies and client IPs are correct)
CRX_FORWARD_HEADERS=none
